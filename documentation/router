<?php
require_once("controllers/DemandeController.php");
require_once("strategies/AcceptStrategy.php");
require_once("strategies/RefuseStrategy.php");

$action = $_GET['action'] ?? null;

if ($action == "submit") {
    $controller = new DemandeController();
    $controller->submit();
}

if ($action == "accept") {
    $strategy = new AcceptStrategy();
    $strategy->execute($_GET['id']);
    header("Location: views/dashboard.php");
}

if ($action == "refuse") {
    $strategy = new RefuseStrategy();
    $strategy->execute($_GET['id']);
    header("Location: views/dashboard.php");
}
?>
