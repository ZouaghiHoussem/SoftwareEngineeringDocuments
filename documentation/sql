CREATE DATABASE football_academy;

CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nom VARCHAR(100),
    age INT,
    email VARCHAR(100)
);

CREATE TABLE demandes (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT,
    statut VARCHAR(20),
    FOREIGN KEY (user_id) REFERENCES users(id)
);

CREATE TABLE videos (
    id INT AUTO_INCREMENT PRIMARY KEY,
    demande_id INT,
    url VARCHAR(255),
    FOREIGN KEY (demande_id) REFERENCES demandes(id)
);
